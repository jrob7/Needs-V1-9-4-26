# Copy to .env for local development. On Railway, set these as real
# environment variables in the service's Variables tab instead.

# MongoDB Atlas connection string (required)
MONGO_URI=

# JWT signing secrets (required) - generate with: openssl rand -hex 32
JWT_SECRET=
REFRESH_SECRET=

# Server port (optional, defaults to 3000)
PORT=3000

# Base URLs for the two backend services (optional, have defaults in code)
NODE_API=http://localhost:3000
FLASK_API=https://llama-go-production.up.railway.app
MODULE_BASE_URL=

# Google Calendar OAuth (required only for calendar integration features)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
