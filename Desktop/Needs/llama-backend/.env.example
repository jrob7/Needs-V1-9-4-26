# Copy to .env for local development. On Railway, set these as real
# environment variables in the service's Variables tab instead.

# MongoDB Atlas connection string (required)
MONGO_URI=

# Mistral API (Pixtral/Voxtral image, video, and text AI features)
MISTRAL_API_KEY=

# Optional alternate inference provider
AI_PROVIDER=
RUNPOD_API_KEY=
RUNPOD_API_URL=
RUNPOD_MODEL=
